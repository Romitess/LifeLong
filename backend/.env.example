# Application Configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:9000,http://lll.localhost,http://moodle.localhost
FRONTEND_URL=http://localhost:9000
BACKEND_PUBLIC_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lifelong2

# Security
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS_PLACEHOLDER

# Rate Limiting
RATE_LIMIT_LOGIN_TTL=60000
RATE_LIMIT_LOGIN_LIMIT=5

# University Directory (BUU MSG API Integration)
# Modes: manual | msg
UNIVERSITY_DIRECTORY_MODE=manual
BUU_DOMAIN=https://api.buu.ac.th/
BUU_REQUEST_TOKEN_PATH=/oauth2/token
BUU_REQUEST_CLIENT_ID=YOUR_BUU_CLIENT_ID
BUU_REQUEST_CLIENT_SECRET=YOUR_BUU_CLIENT_SECRET
BUU_REQUEST_GRANT_TYPE=password
BUU_REQUEST_AUTH_USERID=YOUR_BUU_AUTH_USERID
BUU_SEND_EMAIL_PROVISION_KEY=YOUR_BUU_SEND_EMAIL_PROVISION_KEY

# Moodle Integration
MOODLE_BASE_URL=http://localhost:8080
MOODLE_PUBLIC_URL=http://localhost:8080
MOODLE_TOKEN=YOUR_MOODLE_TOKEN

# Moodle direct DB connection (Personal WS Token Infra)
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=moodle_password
MOODLE_DB_NAME=moodle
MOODLE_WS_SERVICE_ID=4
MOODLE_WS_CREATOR_ID=2

# Platform Gateway (MinIO / ShortURL / Email / Timestamp etc.)
PLATFORM_GATEWAY_DOMAIN=https://gateway.example.com
PLATFORM_GATEWAY_BUCKET=lifelong-bucket
PLATFORM_GATEWAY_CLIENT_ID=YOUR_GATEWAY_CLIENT_ID
PLATFORM_GATEWAY_CLIENT_SECRET=YOUR_GATEWAY_CLIENT_SECRET
PLATFORM_GATEWAY_TOKEN_PATH=/oauth2/token
PLATFORM_GATEWAY_GRANT_TYPE=client_credentials
PLATFORM_GATEWAY_AUTHENTICATED_USERID=gateway-user

# === Seeding & Maintenance Scripts Configuration ===

# Seed scripts database configuration (if different from main app)
# Used by scripts/seed-moodle-rosters.js and other Node.js seed scripts
SEED_MOODLE_DB_HOST=localhost
SEED_MOODLE_DB_PORT=3307
SEED_MOODLE_DB_USER=bn_moodle
SEED_MOODLE_DB_PASSWORD=   # REQUIRED - no default fallback for security
SEED_MOODLE_DB_NAME=LLLv.2

SEED_APP_DB_HOST=localhost
SEED_APP_DB_PORT=3306
SEED_APP_DB_USER=root
SEED_APP_DB_PASSWORD=      # REQUIRED - no default fallback for security
SEED_APP_DB_NAME=lifelong2

# Seed password for test/demo users created by seed scripts
# Used by scripts/seed-test-users.js and other seeding operations
SEED_USER_PASSWORD=        # REQUIRED - default password for seeded test users

# Python scripts specific configuration (for scripts/add_student_data.py)
# These are separate to allow Python scripts to run independently
PYTHON_BACKEND_DB_HOST=localhost
PYTHON_BACKEND_DB_PORT=3306
PYTHON_BACKEND_DB_USER=root
PYTHON_BACKEND_DB_PASSWORD=  # REQUIRED - no default fallback for security
PYTHON_BACKEND_DB_NAME=lifelong2

PYTHON_MOODLE_DB_HOST=localhost
PYTHON_MOODLE_DB_PORT=3307
PYTHON_MOODLE_DB_USER=bn_moodle
PYTHON_MOODLE_DB_PASSWORD=   # REQUIRED - no default fallback for security
PYTHON_MOODLE_DB_NAME=LLLv.2

# Optional: For scratch/mock-moodle-user.js testing script
MOODLE_TEST_PASSWORD=        # Falls back to SEED_USER_PASSWORD if not set
