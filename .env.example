NODE_ENV=development
PORT=3000
BACKEND_PUBLIC_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://host.docker.internal:3000
BACKEND_URL=http://localhost:3000
VITE_API_URL=
VITE_BACKEND_PUBLIC_URL=http://localhost:3000
VITE_MOODLE_URL=http://localhost:8080

# ============= LLLV2 ===============
DB_TYPE=mysql
DB_URL=db/phpmyadmin
DB_HOST=db
DB_PORT=3306
DB_USER=lifelong2
DB_PASSWORD=DB_PASSWORD_PLACEHOLDER
DB_NAME=lifelong2

MOODLE_BASE_URL=http://localhost:8080
MOODLE_PUBLIC_URL=http://localhost:8080
MOODLE_TOKEN=MOODLE_TOKEN_PLACEHOLDER
MOODLE_ADMIN_PASSWORD=MOODLE_ADMIN_PASSWORD_PLACEHOLDER
MOODLE_THEME=lifelong2

# Per-user Moodle WS token infra (native quiz/assign). Backend connects to the Moodle DB
# to mint/read a personal WS token per enrolled student (token stays server-side).
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3307
MOODLE_DB_USER=MOODLE_DB_USER_PLACEHOLDER
MOODLE_DB_PASSWORD=MOODLE_DB_PASSWORD_PLACEHOLDER
MOODLE_DB_NAME=MOODLE_DB_NAME_PLACEHOLDER
MOODLE_WS_SERVICE_ID=4
MOODLE_WS_CREATOR_ID=2

JWT_SECRET=JWT_SECRET_PLACEHOLDER_MIN_32_CHARS_REPLACE_THIS

BUU_DOMAIN = https://kong-dev.buu.ac.th/
BUU_REQUEST_TOKEN_PATH=/oauth2/token/
BUU_REQUEST_CLIENT_SECRET=BUU_REQUEST_CLIENT_SECRET_PLACEHOLDER
BUU_REQUEST_CLIENT_ID=BUU_REQUEST_CLIENT_ID_PLACEHOLDER
BUU_REQUEST_GRANT_TYPE = password
BUU_REQUEST_AUTH_USERID = zoom-pooling-kong
BUU_UPLOAD_FILE_PROVISION_KEY=BUU_UPLOAD_FILE_PROVISION_KEY_PLACEHOLDER
BUU_GET_PUBLIC_FILE_PROVISION_KEY=BUU_GET_PUBLIC_FILE_PROVISION_KEY_PLACEHOLDER
BUU_DELETE_FILE_PROVISION_KEY=BUU_DELETE_FILE_PROVISION_KEY_PLACEHOLDER
BUU_SEND_EMAIL_PROVISION_KEY=BUU_SEND_EMAIL_PROVISION_KEY_PLACEHOLDER

# --- University Directory (Task 1A) ---
# manual = use LLTPRIVILEGE as allowlist (admin-managed)
# msg    = call BUU MSG API (Task 1C, requires credentials above)
UNIVERSITY_DIRECTORY_MODE=manual

