{
  "name": "lifelong2",
  "private": true,
  "description": "Combined Lifelong2 frontend and backend workspace",
  "scripts": {
    "install:front": "npm --prefix frontend install",
    "install:back": "npm --prefix backend install",
    "install:all": "npm run install:front && npm run install:back",
    "dev:front": "npm --prefix frontend run dev",
    "dev:back": "npm --prefix backend run start:dev",
    "build:front": "npm --prefix frontend run build",
    "build:back": "npm --prefix backend run build",
    "build:all": "npm run build:front && npm run build:back",
    "start:back": "npm --prefix backend run start:prod",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11.0.0"
  }
}
